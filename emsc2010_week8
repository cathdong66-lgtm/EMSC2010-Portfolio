      "source": [
        "data = pd.DataFrame({\"x\": year, \"y\": cumul_rise}) #put the data into a dataframe with variable names \"x\" and \"y\".\n",
        "data[\"x_scaled\"] = (year-np.mean(year)) / np.std(year) #scale the x values to have a mean of 0 and stdev of 1\n",
        "data[\"x2_scaled\"] = data[\"x_scaled\"] ** 2 #used for quadratic regression\n",
        "data[\"x3_scaled\"] = data[\"x_scaled\"] ** 3 #used for cubic regression\n",
        "data[\"x4_scaled\"] = data[\"x_scaled\"] ** 4 #used for quartic regression\n",
        "data[\"x5_scaled\"] = data[\"x_scaled\"] ** 5 #used for quintic regression\n",
        "data[\"x6_scaled\"] = data[\"x_scaled\"] ** 6 #used for sextic regression"
